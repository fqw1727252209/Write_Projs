<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.study.platform.mapper.StudyPlanMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.study.platform.entity.StudyPlan">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="plan_name" property="planName"/>
        <result column="plan_goal" property="planGoal"/>
        <result column="start_date" property="startDate"/>
        <result column="end_date" property="endDate"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 根据用户ID查询学习计划列表 -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM study_plan WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <!-- 根据用户ID和状态查询学习计划列表 -->
    <select id="selectByUserIdAndStatus" resultMap="BaseResultMap">
        SELECT * FROM study_plan WHERE user_id = #{userId} AND status = #{status} ORDER BY create_time DESC
    </select>

    <!-- 根据ID查询学习计划 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM study_plan WHERE id = #{id}
    </select>

    <!-- 插入学习计划 -->
    <insert id="insert" parameterType="com.study.platform.entity.StudyPlan" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO study_plan (user_id, plan_name, plan_goal, start_date, end_date, description, status)
        VALUES (#{userId}, #{planName}, #{planGoal}, #{startDate}, #{endDate}, #{description}, #{status})
    </insert>

    <!-- 更新学习计划 -->
    <update id="update" parameterType="com.study.platform.entity.StudyPlan">
        UPDATE study_plan
        <set>
            <if test="planName != null">plan_name = #{planName},</if>
            <if test="planGoal != null">plan_goal = #{planGoal},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除学习计划 -->
    <delete id="deleteById">
        DELETE FROM study_plan WHERE id = #{id}
    </delete>

    <!-- 统计用户的计划数量 -->
    <select id="countByUserId" resultType="int">
        SELECT COUNT(*) FROM study_plan WHERE user_id = #{userId}
    </select>

    <!-- 统计用户已完成的计划数量 -->
    <select id="countCompletedByUserId" resultType="int">
        SELECT COUNT(*) FROM study_plan WHERE user_id = #{userId} AND status = 1
    </select>

</mapper>

