<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.study.platform.mapper.UserMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.study.platform.entity.User">
        <id column="id" property="id"/>
        <result column="student_id" property="studentId"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="major" property="major"/>
        <result column="grade" property="grade"/>
        <result column="email" property="email"/>
        <result column="phone" property="phone"/>
        <result column="avatar" property="avatar"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 根据学号查询用户 -->
    <select id="selectByStudentId" resultMap="BaseResultMap">
        SELECT * FROM user WHERE student_id = #{studentId}
    </select>

    <!-- 根据ID查询用户 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM user WHERE id = #{id}
    </select>

    <!-- 插入用户 -->
    <insert id="insert" parameterType="com.study.platform.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (student_id, username, password, major, grade, email, phone, avatar)
        VALUES (#{studentId}, #{username}, #{password}, #{major}, #{grade}, #{email}, #{phone}, #{avatar})
    </insert>

    <!-- 更新用户信息 -->
    <update id="update" parameterType="com.study.platform.entity.User">
        UPDATE user
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="major != null">major = #{major},</if>
            <if test="grade != null">grade = #{grade},</if>
            <if test="email != null">email = #{email},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除用户 -->
    <delete id="deleteById">
        DELETE FROM user WHERE id = #{id}
    </delete>

</mapper>

